{
  "version": 2,
  "installCommand": "npm install --prefix backend && npm install --prefix frontend && npm run build --prefix frontend",
  "functions": {
    "api/index.js": {
      "includeFiles": "frontend/dist/**"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}